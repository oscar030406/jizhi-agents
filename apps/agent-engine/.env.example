APP_ENV=local
LOG_LEVEL=INFO

# ---- HTTP 层（app/，线上 8001 入口）----------------------------------------
# 内部鉴权 Token，必须与 classroom 的 GROUNDING_TOKEN 一致，只能用 ASCII。
AI_SERVICE_TOKEN=AI_SERVICE_TOKEN_PLACEHOLDER
# 生产用 INFO；本地要看大模型完整入参和返回时临时改 DEBUG。
AI_SERVICE_LOG_LEVEL=INFO
# 刷题评分模型，OpenAI 兼容服务填到 /v1；LOCAL_RULE 表示不发起外部请求。
AI_GRADING_BASE_URL=
AI_GRADING_API_KEY=
AI_GRADING_MODEL=LOCAL_RULE
AI_GRADING_MODEL_PROVIDER=
AI_GRADING_TIMEOUT_SECONDS=20
AI_GRADING_MAX_OUTPUT_TOKENS=600

# ---- 引擎层（backend/）------------------------------------------------------

# 推荐配置：硅基流动一个 key 覆盖三档，三厂商异构（Qwen 快线 / DeepSeek 生成 / GLM 审核）。
# 模型 ID 以 https://api.siliconflow.cn/v1/models 实际返回为准。
LLM_PROVIDER_FAST=siliconflow
LLM_MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_PROVIDER_STRONG=siliconflow
LLM_MODEL_STRONG=deepseek-ai/DeepSeek-V3.2
LLM_PROVIDER_JUDGE=siliconflow
LLM_MODEL_JUDGE=zai-org/GLM-5.2
LLM_TIMEOUT_SECONDS=150

# 只填实际使用的 key。不要提交真实 key。
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# 实操项目侦察（backend/services/practice_scout.py）走 GitHub 公开 API。
# 不填也能跑，只是按匿名配额：搜索 10 次/分、core 60 次/小时/IP，代码自动把节拍放慢到 6.5 秒，
# 一台机器一小时最多起草 4 次。填一个只读 PAT（public_repo 足够）就切到 2.2 秒节拍、配额 5000/小时。
GITHUB_TOKEN=
